<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme: Netflix-style dark Material 3 -->
    <style name="Base.Theme.MovieFinder" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Global colors -->
        <item name="colorPrimary">@color/nf_red</item>
        <item name="colorPrimaryContainer">@color/nf_dark_surface</item>
        <item name="colorSecondary">@color/nf_gold</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/nf_black</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/nf_black</item>

        <!-- App bar & background -->
        <item name="android:windowBackground">@color/nf_dark_background</item>
    </style>

    <style name="Theme.MovieFinder" parent="Base.Theme.MovieFinder" />
</resources>